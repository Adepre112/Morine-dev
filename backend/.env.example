# ============================================
# MORINE — Environment Configuration
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# -----------------------------------------
# Mode
# -----------------------------------------
# Set to "development" for local localhost work.
# Set to "production" for deployed environments.
NODE_ENV=development

# -----------------------------------------
# Mock data mode (set to "false" when API credits reset)
# -----------------------------------------
USE_MOCK_DATA=true

# -----------------------------------------
# Parse HotNigerianJobs API credentials (fallback)
# -----------------------------------------
PARSE_API_KEY=YOUR_API_KEY_HERE

# -----------------------------------------
# MongoDB Atlas connection URI
# -----------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/morine?retryWrites=true&w=majority

# -----------------------------------------
# AI Provider selection: groq | openai | gemini
# -----------------------------------------
AI_PROVIDER=gemini
# Google Gemini API key (server-side only) — https://aistudio.google.com/apikey
# Model defaults to gemini-3.1-flash-lite (stable, structured JSON). Override with GEMINI_MODEL.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Groq API key (OpenAI-compatible) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenAI API key for CV AI analysis/optimization
# Get a key at https://platform.openai.com/api-keys
# Model defaults to gpt-4o-mini (cost-effective). Override with OPENAI_MODEL=gpt-4o if needed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------
# JWT Authentication (access 30m, refresh 30d via HttpOnly cookie)
# -----------------------------------------
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET
JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_ACCESS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_REFRESH
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d
# Legacy JWT_EXPIRES_IN kept for backward compatibility (7d); prefer ACCESS/REFRESH above
JWT_EXPIRES_IN=7d

# -----------------------------------------
# Server configuration
# -----------------------------------------
# PORT will use process.env.PORT if set (production platforms), otherwise 3000
PORT=3000

# -----------------------------------------
# Frontend URL (for CORS)
# -----------------------------------------
# Development: http://localhost:3000
# Production: https://your-deployed-domain.com
FRONTEND_URL=http://localhost:3000
