# ============================================
# MORINE — Environment Configuration
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# -----------------------------------------
# Mode
# -----------------------------------------
# Set to "development" for local localhost work.
# Set to "production" for deployed environments.
NODE_ENV=development

# -----------------------------------------
# Job Listings API (live job opportunities, Nigeria only)
# -----------------------------------------
# Official docs: https://www.joblistingsapi.com/docs
# Base URL is fixed in backend/config/index.js. Only the key is configurable.
# The app always requests country=NG and caches results for 30 minutes.
JOB_LISTING_API_KEY=YOUR_JOB_LISTINGS_API_KEY_HERE
# Remote-only filtering is a user-facing toggle in the app, not a server setting.

# -----------------------------------------
# MongoDB Atlas connection URI
# -----------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/morine?retryWrites=true&w=majority

# -----------------------------------------
# AI Provider selection: groq | openai | gemini
# -----------------------------------------
AI_PROVIDER=gemini
# Google Gemini API key (server-side only) — https://aistudio.google.com/apikey
# Model defaults to gemini-3.1-flash-lite (stable, structured JSON). Override with GEMINI_MODEL.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Groq API key (OpenAI-compatible) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OpenAI API key for CV AI analysis/optimization
# Get a key at https://platform.openai.com/api-keys
# Model defaults to gpt-4o-mini (cost-effective). Override with OPENAI_MODEL=gpt-4o if needed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------
# JWT Authentication (access token 30m; refresh token 30d)
# -----------------------------------------
# JWT_SECRET is the ONLY required JWT variable. middleware/auth.js calls
# process.exit(1) at boot if it is missing, and it is the single secret declared
# in render.yaml. Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET

# Access-token lifetime. Optional; the code falls back to 30m if unset.
JWT_ACCESS_EXPIRES_IN=30m

# OPTIONAL per-token secret overrides. backend/middleware/auth.js reads these as
#   JWT_ACCESS_SECRET  = process.env.JWT_ACCESS_SECRET  || JWT_SECRET
#   JWT_REFRESH_SECRET = process.env.JWT_REFRESH_SECRET || JWT_SECRET
# so leaving BOTH unset means access and refresh tokens are signed with
# JWT_SECRET. That single-secret setup is what render.yaml provisions, and it is
# the recommended default. Set these ONLY if you deliberately want separate
# signing keys, and then rotate/revoke both accordingly. They are NOT required.
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# The refresh session lifetime is NOT configured here. It is enforced by the
# RefreshToken.expiresAt field plus the TTL index on that collection, and
# matched by the refresh cookie's Max-Age in backend/controllers/authController.js.
# The two variables below are NOT read anywhere in the code and are listed only
# so their absence is not mistaken for an oversight.
# JWT_REFRESH_EXPIRES_IN=30d   (unused - not read by any code)
# JWT_EXPIRES_IN=7d            (unused legacy - not read by any code)

# -----------------------------------------
# PORT
# -----------------------------------------
# Do NOT set this on Render. Render injects PORT itself, and
# server.js already uses `process.env.PORT || 3000`, so production binds to
# whatever Render provides and local development stays on 3000.
PORT=3000

# -----------------------------------------
# Password-reset email
# -----------------------------------------
# Morine sends the password-reset mail through ONE of two transports. The choice
# is made by EMAIL_PROVIDER and by nothing else.
#
#   brevo  - Brevo's REST API over HTTPS (port 443). THIS IS THE PRODUCTION
#            TRANSPORT, because Render blocks outbound SMTP on ports 25/465/587
#            and Nodemailer therefore cannot deliver anything from a deployed
#            instance. See https://developers.brevo.com/reference/send-transac-email
#   smtp   - Nodemailer. Local development only. This is also the default when
#            EMAIL_PROVIDER is unset, which is why an unset value in production
#            produces a reset that answers HTTP 200 and delivers nothing.
EMAIL_PROVIDER=brevo

# Brevo API key -> https://app.brevo.com/settings/keys/api
# Read only into the `api-key` request header. Never logged, never returned.
BREVO_API_KEY=

# The sender address. TWO rules, both required by Brevo:
#   1. BARE address. Brevo's `sender.email` is `format: email` and rejects a
#      display-name wrapper such as "Morine <noreply@example.com>" with HTTP
#      400. services/emailService.js will strip a wrapper, but write the bare
#      address here so there is no ambiguity.
#   2. REGISTERED AND VERIFIED in the Brevo account
#      -> https://app.brevo.com/settings/senders
#      An unverified sender is refused with 400 and the mail is never sent.
EMAIL_FROM=noreply@example.com

# Sender display name, sent to Brevo as `sender.name` (max 70 characters).
# This is the display name ONLY - an email address is not valid here.
EMAIL_FROM_NAME=Morine

# Optional. Brevo request timeout in milliseconds.
# Defaults to 10000; values above 60000 are capped. Raise it only if Brevo
# answers slowly - a timeout is reported as class=CONNECTION_FAILED.
# EMAIL_TIMEOUT_MS=10000

# --- Legacy SMTP fallback (EMAIL_PROVIDER=smtp, local development) ---------
# Only read when EMAIL_PROVIDER is anything other than "brevo". On Render these
# cannot egress, which is exactly why production uses the HTTPS path above.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_PASS=              # Gmail: an App Password, never the account password

# -----------------------------------------
# Password-reset link host
# -----------------------------------------
# The reset link is built from the request's Host header. That header is
# attacker-controlled the moment anyone can reach the process directly, so
# authController.js only mints a link for a host on this allowlist and refuses
# (and sends nothing) otherwise. This is a security control, not a convenience.
#
# Production lists the host the frontend is actually served from:
#   https://morine-ai.onrender.com
# morine.onrender.com is a separate legacy service on the same database and is
# deliberately NOT listed. Add a host here only if it genuinely serves the
# production frontend.
#
# Comma-separated. A leading "." opts an entry into subdomains, e.g.
# ".yourdomain.com". Leave UNSET locally: development is unrestricted so LAN
# testing on 192.168.x.x:3000 keeps working.
# RESET_ALLOWED_HOSTS=morine-ai.onrender.com

# -----------------------------------------
# FRONTEND_URL — leave UNSET
# -----------------------------------------
# Morine is a SINGLE-ORIGIN app: one Render Web Service runs Express, which
# serves the frontend, the /api/* routes and all static assets from the same
# host. The browser therefore makes same-origin requests and never performs a
# CORS check.
#
# server.js mounts CORS ONLY when FRONTEND_URL is set, and it never falls back
# to a localhost default. So with this variable absent there is no CORS surface
# at all, which is exactly what the Render deployment should have. Setting it to
# http://localhost:3000 in production would advertise localhost as a trusted
# origin, which is a security regression, not a convenience.
#
# LEAVE THIS COMMENTED OUT. render.yaml deliberately does not declare it either.
#
# Only uncomment it for a deliberate, separate extra origin, e.g. when a real
# second host genuinely needs to call this API:
#   FRONTEND_URL=https://example.com
# Local development does not need it, because localhost:3000 is already
# same-origin with the API.
# FRONTEND_URL=
